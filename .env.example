# Your Cal.com event link, e.g. unitedreason/intro.
# Leave unset until the event exists — /book falls back to email rather than
# rendering Cal's "event type not found" screen.
NEXT_PUBLIC_CAL_LINK=

# Resend API key, for delivering the enquiry and newsletter forms.
# Leave unset and both forms hand off to the visitor's mail client instead —
# nothing claims to have been received that hasn't been. Sending from
# hello@unitedreason.org needs the domain verified in Resend first.
RESEND_API_KEY=
